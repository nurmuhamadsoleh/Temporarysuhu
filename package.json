{
  "name": "temperature-monitoring-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "check:imports": "node scripts/check-imports.mjs",
    "prebuild": "node scripts/check-imports.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build --webpack",
    "start": "node scripts/start-production.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "user:hash": "node scripts/hash-password.mjs",
    "db:init": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/initialize.mjs",
    "users:admin": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/users-admin.ts",
    "production:check": "node --conditions=react-server --import tsx scripts/production-check.ts",
    "production:probe": "node scripts/production-probe.mjs"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@hookform/resolvers": "^5.2.0",
    "@next/env": "^16.4.3",
    "@signpdf/placeholder-pdf-lib": "^3.2.4",
    "@signpdf/signer-p12": "^3.2.4",
    "@signpdf/signpdf": "^3.2.4",
    "@tailwindcss/postcss": "^4.1.0",
    "antd": "^6.6.8",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.23",
    "fflate": "^0.8.3",
    "googleapis": "^164.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.13",
    "node-forge": "^1.3.1",
    "pdf-lib": "^1.17.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.66.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.11",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-signature-canvas": "^1.0.7",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "gaxios": "^7.3.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    }
  }
}
